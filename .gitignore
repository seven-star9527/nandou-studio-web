# Publish only project sources and intentionally public assets.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/DESIGN.md
!/frontend/
!/gateway/
!/integrations/
!/docs/
/docs/*
!/docs/DEPLOYMENT.md
/frontend/*
!/frontend/.gitignore
!/frontend/index.html
!/frontend/package.json
!/frontend/pnpm-lock.yaml
!/frontend/pnpm-workspace.yaml
!/frontend/tsconfig.json
!/frontend/vite.config.ts
!/frontend/src/
!/frontend/public/
# Rejected and test showcase assets remain local.
/frontend/public/showcase/*
!/frontend/public/showcase/flare-clean-watercolor-box.webp
!/frontend/public/showcase/nano-toy-kitchen.webp
!/frontend/public/showcase/sunburst-straight-brush-studio.webp
!/frontend/public/showcase/turbo-brush-main-v3.webp
**/.env
**/.env.*
**/*credentials*
**/*secret*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.ldb
**/*.log
**/*.pyc
**/__pycache__/
**/node_modules/
**/dist/
**/bin/
**/obj/
**/*.tsbuildinfo
**/tests/
**/test/
**/*.test.*
**/*.spec.*
**/scripts/
**/*.ps1
**/*.bat
**/*.cmd
**/*.sh
**/.DS_Store
**/Thumbs.db
